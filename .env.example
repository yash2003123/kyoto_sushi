# Mollie hosted checkout. Leave empty to run the order flow in simulation mode.
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=

# Public base URL used for Mollie redirect + webhook URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kitchen ticket delivery (cloud receipt printer / tablet relay endpoint).
KITCHEN_WEBHOOK_URL=
KITCHEN_WEBHOOK_TOKEN=
