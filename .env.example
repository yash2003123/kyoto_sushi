# ---------------------------------------------------------------------------
# Copy to .env.local for development. On Vercel, set these as project
# environment variables instead.
# ---------------------------------------------------------------------------

# Payment ------------------------------------------------------------------
# Mollie API key. Starts with test_ for the test account, live_ for real money.
# LEAVE EMPTY to run the whole order flow in simulation mode: a real order is
# created, the payment step is skipped, and the customer lands on the
# confirmation page. Useful before the merchant account exists.
MOLLIE_API_KEY=

# Public base URL --------------------------------------------------------
# Required in production: Mollie's webhook has to reach this address from the
# public internet, so it can never be localhost. When unset, the app falls back
# to the origin the request arrived on, which is fine locally but leaves the
# webhook with nowhere to call.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Order storage ------------------------------------------------------------
# REQUIRED IN PRODUCTION. Every API route is a separate serverless function on
# Vercel, so orders cannot live in the app's memory: the checkout would write
# an order that the Mollie webhook can never find, and the kitchen would never
# be told about a payment that succeeded.
#
# Easiest setup: in the Vercel dashboard open Storage -> Upstash for Redis and
# connect it to the project. Vercel injects KV_REST_API_URL and
# KV_REST_API_TOKEN for you; you do not type them by hand. A standalone Upstash
# project works too, via UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
#
# Left empty in development, the app keeps orders in process memory so
# `npm run dev` needs no setup. Left empty in PRODUCTION, /api/checkout refuses
# with a 503 rather than take money it cannot record.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Kitchen ------------------------------------------------------------------
# Where a paid order's ticket is POSTed the moment the payment clears. This is
# meant to be the cloud receipt printer next to the sushi counter (or a relay
# that talks to it and to the tablet). If unset, tickets are written to the
# server log instead, so nothing is lost during a pilot — but nothing prints.
KITCHEN_WEBHOOK_URL=
# Sent as `Authorization: Bearer <token>` if set. Optional.
KITCHEN_WEBHOOK_TOKEN=

# Service controls ---------------------------------------------------------
# The two switches the counter needs during a service. Both take effect on the
# next request; no code change, no redeploy of the app itself.
#
# ORDERS_PAUSED=1 stops new online orders entirely. The slot picker empties and
# the pay button is disabled, with an explanation in the customer's language.
ORDERS_PAUSED=
# KITCHEN_BUSY=1 pushes preparation time from 30 to 60 minutes, which moves the
# earliest bookable slot an extra half hour out.
KITCHEN_BUSY=
